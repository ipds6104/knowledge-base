<mxfile host="cli-anything" agent="cli-anything-drawio/1.0.0" version="24.0.0"><diagram id="diagram_pss_2026" name="Alur-PSS-2026-Presentation"><mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="1"><root><mxCell id="0" /><mxCell id="1" parent="0"><mxCell id="btn_5" parent="1" vertex="1" value="&lt;div style=&quot;font-family: Segoe UI, sans-serif; text-align: left; line-height: 1.25;&quot;&gt;&#10;          &lt;div style=&quot;font-size: 11px; font-weight: 800; color: #A78BFA; margin-bottom: 2px;&quot;&gt;&#10;            📚 6. MATERI &amp;amp; JUKNIS PSS&#10;          &lt;/div&gt;&#10;          &lt;div style=&quot;font-size: 10.5px; font-weight: 700; color: #FFFFFF; background: #1E293B; padding: 2px 5px; border-radius: 4px; display: inline-block; margin-bottom: 3px; border: 1px solid #8B5CF6;&quot;&gt;&#10;            Tombol 6 di s.id/pss-mpw-2026&#10;          &lt;/div&gt;&#10;          &lt;div style=&quot;font-size: 9px; color: #CBD5E1; line-height: 1.25;&quot;&gt;&#10;            Unduh slide materi 5 domain BPS &amp;amp; Kepka No. 996/2025.&#10;          &lt;/div&gt;&#10;        &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#8B5CF6;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingTop=6;spacingLeft=8;spacingRight=8;spacingBottom=6;"><mxGeometry as="geometry" x="1570" y="946" width="288" height="108" /></mxCell></mxCell><mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;strokeWidth=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="0" y="0" width="1920" height="1080" /></mxCell><mxCell id="header_bar" value="&lt;div style=&quot;text-align: center; color: #FFFFFF; font-family: Segoe UI, Roboto, Helvetica, Arial, sans-serif;&quot;&gt;  &lt;div style=&quot;font-size: 19px; font-weight: 800; letter-spacing: 0.5px; line-height: 1.2; margin-bottom: 3px;&quot;&gt;    PETA JALUR KERJA OPERATOR OPD: PEMBINAAN STATISTIK SEKTORAL (PSS) 2026  &lt;/div&gt;  &lt;div style=&quot;font-size: 12px; color: #94A3B8; font-weight: 500; line-height: 1.2;&quot;&gt;    Panduan Terpadu 23 OPD Kabupaten Mempawah Menuju Kepatuhan SDI, Pengamanan TPSS BPS (Target 99.09), dan Lonjakan Nilai IPS EPSS 2028 (Predikat Sangat Baik)  &lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#334155;strokeWidth=1.5;shadow=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="14" width="1840" height="68" /></mxCell><mxCell id="badge1" value="&lt;div style=&quot;text-align: center; color: #38BDF8; font-size: 10px; font-weight: 700; line-height: 1.2;&quot;&gt;🏛️ BPS SATKER 6104&lt;br/&gt;&lt;span style=&quot;color:#CBD5E1; font-weight: 400;&quot;&gt;Pembina Statistik&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0284C7;strokeWidth=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="55" y="20" width="160" height="56" /></mxCell><mxCell id="badge2" value="&lt;div style=&quot;text-align: center; color: #34D399; font-size: 10px; font-weight: 700; line-height: 1.2;&quot;&gt;🛡️ DISKOMINFO&lt;br/&gt;&lt;span style=&quot;color:#CBD5E1; font-weight: 400;&quot;&gt;Walidata Pemda&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#059669;strokeWidth=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="225" y="20" width="160" height="56" /></mxCell><mxCell id="badge3" value="&lt;div style=&quot;text-align: center; color: #FBBF24; font-size: 10px; font-weight: 700; line-height: 1.2;&quot;&gt;📋 BAPPEDA&lt;br/&gt;&lt;span style=&quot;color:#CBD5E1; font-weight: 400;&quot;&gt;Sekretariat SDI&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#D97706;strokeWidth=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="1705" y="20" width="160" height="56" /></mxCell><mxCell id="swim_0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0369A1;strokeWidth=1;opacity=50;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="92" width="345" height="813" /></mxCell><mxCell id="swim_1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#047857;strokeWidth=1;opacity=50;" vertex="1" parent="1"><mxGeometry as="geometry" x="403" y="92" width="345" height="813" /></mxCell><mxCell id="swim_2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1;opacity=50;" vertex="1" parent="1"><mxGeometry as="geometry" x="766" y="92" width="345" height="813" /></mxCell><mxCell id="swim_3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=1;opacity=50;" vertex="1" parent="1"><mxGeometry as="geometry" x="1129" y="92" width="345" height="813" /></mxCell><mxCell id="swim_4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#115E59;strokeWidth=1;opacity=50;" vertex="1" parent="1"><mxGeometry as="geometry" x="1492" y="92" width="388" height="813" /></mxCell><mxCell id="head_0" value="&lt;div style=&quot;text-align: center; color: #FFFFFF; font-family: Segoe UI, sans-serif; line-height: 1.2;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 14px; font-weight: 800; letter-spacing: 0.3px;&quot;&gt;TAHAP 1: IDENTIFIKASI&lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10px; opacity: 0.9; font-weight: 500;&quot;&gt;Rabu, 4 Nov 2026 | 08.00-11.15 WIB&lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 11px; font-weight: 700; color: #BAE6FD; margin-top: 2px;&quot;&gt;Pemetaan 23 OPD &amp; LK-01 Bersama&lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0369A1;strokeWidth=1.5;shadow=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="98" width="345" height="62" /></mxCell><mxCell id="card_0_1" value="&lt;div style=&quot;font-family: Segoe UI, sans-serif; line-height: 1.35;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 12px; font-weight: 800; color: #0369A1; border-bottom: 1.5px solid #BAE6FD; padding-bottom: 2px; margin-bottom: 5px;&quot;&gt;&#10;        📊 1. PLATFORM KERJA LIVE MCC&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #0284C7; font-weight: 700; margin-bottom: 5px; background: #E0F2FE; padding: 2px 5px; border-radius: 4px; display: inline-block;&quot;&gt;&#10;        🔗 s.id/pss-mempawah-sheet&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #334155;&quot;&gt;&#10;        • &lt;b&gt;Google Sheets Bersama 23 OPD&lt;/b&gt;&lt;br/&gt;&#10;        • Buka tab: &lt;b&gt;FORM_IDENTIFIKASI_LK01&lt;/b&gt;&lt;br/&gt;&#10;        • Pantau tab: &lt;b&gt;RADAR_23_OPD&lt;/b&gt; (auto live)&lt;br/&gt;&#10;        • &lt;i&gt;Meja pembina BPS mendampingi langsung&lt;/i&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="168" width="325" height="150" /></mxCell><mxCell id="card_0_2" value="&lt;div style=&quot;font-family: Segoe UI, sans-serif; line-height: 1.35;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 12px; font-weight: 800; color: #0369A1; border-bottom: 1.5px solid #BAE6FD; padding-bottom: 2px; margin-bottom: 6px;&quot;&gt;&#10;        📝 2. AKSI ENTRI OPERATOR&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #1E293B;&quot;&gt;&#10;        • Masukkan &lt;b&gt;Nama OPD&lt;/b&gt; &amp;amp; &lt;b&gt;Pejabat PJ&lt;/b&gt;&lt;br/&gt;&#10;        • Daftarkan 1-2 &lt;b&gt;Kegiatan Statistik Utama&lt;/b&gt;:&lt;br/&gt;&#10;        &amp;nbsp;&amp;nbsp; a. Survei Sektoral, atau&lt;br/&gt;&#10;        &amp;nbsp;&amp;nbsp; b. Kompilasi Produk Administrasi (Kompromin)&lt;br/&gt;&#10;        • Cantumkan &lt;b&gt;Variabel Kunci&lt;/b&gt; yang dihasilkan&lt;br/&gt;&#10;        • Tentukan produsen data &amp;amp; unit pengelola&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;margin-top: 10px; background: #FEF3C7; border: 1px dashed #F59E0B; padding: 5px 6px; border-radius: 4px; font-size: 10px; color: #92400E; font-weight: 600; line-height: 1.25;&quot;&gt;&#10;        💡 &lt;b&gt;Fitur Anti-Pusing:&lt;/b&gt; Seluruh 23 OPD mengisi di 1 sheet yang sama sehingga bisa saling melihat contoh nyata dinas lain!&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="328" width="325" height="320" /></mxCell><mxCell id="card_0_3" value="&lt;div style=&quot;font-family: Segoe UI, sans-serif; line-height: 1.35;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 12px; font-weight: 800; color: #0369A1; border-bottom: 1.5px solid #BAE6FD; padding-bottom: 2px; margin-bottom: 5px;&quot;&gt;&#10;        🔒 3. BUKTI FISIK TERKUNCI&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #0F172A;&quot;&gt;&#10;        ✓ &lt;b&gt;Lembar Kerja LK-01 Lengkap 23 OPD&lt;/b&gt;&lt;br/&gt;&#10;        ✓ Pejabat PJ Produsen Data Terdata Sah&lt;br/&gt;&#10;        ✓ Diverifikasi Tim Pembina BPS Mempawah&lt;br/&gt;&#10;        ✓ &lt;i&gt;Status Radar: Hijau 100% Terisi&lt;/i&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;shadow=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="658" width="325" height="235" /></mxCell><mxCell id="head_1" value="&lt;div style=&quot;text-align: center; color: #FFFFFF; font-family: Segoe UI, sans-serif; line-height: 1.2;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 14px; font-weight: 800; letter-spacing: 0.3px;&quot;&gt;TAHAP 2: SDS &amp; METADATA&lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10px; opacity: 0.9; font-weight: 500;&quot;&gt;Kamis, 5 Nov 2026 | 09.00-12.00 WIB&lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 11px; font-weight: 700; color: #A7F3D0; margin-top: 2px;&quot;&gt;Kamus Variabel &amp; Metadata INDAH&lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#047857;strokeWidth=1.5;shadow=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="403" y="98" width="345" height="62" /></mxCell><mxCell id="card_1_1" value="&lt;div style=&quot;font-family: Segoe UI, sans-serif; line-height: 1.35;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 12px; font-weight: 800; color: #047857; border-bottom: 1.5px solid #A7F3D0; padding-bottom: 2px; margin-bottom: 5px;&quot;&gt;&#10;        🏷️ 1. PORTAL METADATA RESMI&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #059669; font-weight: 700; margin-bottom: 5px; background: #D1FAE5; padding: 2px 5px; border-radius: 4px; display: inline-block;&quot;&gt;&#10;        🔗 indah.bps.go.id&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #334155;&quot;&gt;&#10;        • &lt;b&gt;Aplikasi INDAH Nasional BPS&lt;/b&gt;&lt;br/&gt;&#10;        • Single Sign-On akun operator dinas&lt;br/&gt;&#10;        • Rujukan Kamus: &lt;b&gt;s.id/pss-mpw-2026&lt;/b&gt;&lt;br/&gt;&#10;        • &lt;i&gt;Dibuka pasca data terbit / selesai&lt;/i&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="413" y="168" width="325" height="150" /></mxCell><mxCell id="card_1_2" value="&lt;div style=&quot;font-family: Segoe UI, sans-serif; line-height: 1.35;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 12px; font-weight: 800; color: #047857; border-bottom: 1.5px solid #A7F3D0; padding-bottom: 2px; margin-bottom: 6px;&quot;&gt;&#10;        📝 2. AKSI ENTRI OPERATOR&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #1E293B;&quot;&gt;&#10;        • Padankan ke &lt;b&gt;Standar Data Statistik (SDS)&lt;/b&gt;:&lt;br/&gt;&#10;        &amp;nbsp;&amp;nbsp; konsep, definisi, klasifikasi, ukuran, satuan&lt;br/&gt;&#10;        • Susun 3 Format Metadata Standar:&lt;br/&gt;&#10;        &amp;nbsp;&amp;nbsp; 1. &lt;b&gt;MS-Keg&lt;/b&gt; (Instrumen Kegiatan)&lt;br/&gt;&#10;        &amp;nbsp;&amp;nbsp; 2. &lt;b&gt;MS-Ind&lt;/b&gt; (Indikator Kinerja/Sektoral)&lt;br/&gt;&#10;        &amp;nbsp;&amp;nbsp; 3. &lt;b&gt;MS-Var&lt;/b&gt; (Variabel Pembentuk Data)&lt;br/&gt;&#10;        • Unggah draft ke portal INDAH BPS&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;margin-top: 10px; background: #EDE9FE; border: 1px dashed #8B5CF6; padding: 5px 6px; border-radius: 4px; font-size: 10px; color: #5B21B6; font-weight: 600; line-height: 1.25;&quot;&gt;&#10;        ⚡ &lt;b&gt;Zero Double Entry:&lt;/b&gt; Cukup masukkan ID Rekomendasi ROMANTIK -&amp;gt; rincian MS-Keg langsung terisi otomatis!&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="413" y="328" width="325" height="320" /></mxCell><mxCell id="card_1_3" value="&lt;div style=&quot;font-family: Segoe UI, sans-serif; line-height: 1.35;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 12px; font-weight: 800; color: #047857; border-bottom: 1.5px solid #A7F3D0; padding-bottom: 2px; margin-bottom: 5px;&quot;&gt;&#10;        🔒 3. BUKTI FISIK TERKUNCI&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #0F172A;&quot;&gt;&#10;        ✓ &lt;b&gt;Formulir MS-Keg, MS-Ind, MS-Var&lt;/b&gt;&lt;br/&gt;&#10;        ✓ Kamus Variabel Terstandarisasi SDS&lt;br/&gt;&#10;        ✓ Berita Acara Rekonsiliasi Metadata&lt;br/&gt;&#10;        ✓ &lt;i&gt;Terkoneksi ke Basis Data SDI&lt;/i&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;shadow=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="413" y="658" width="325" height="235" /></mxCell><mxCell id="head_2" value="&lt;div style=&quot;text-align: center; color: #FFFFFF; font-family: Segoe UI, sans-serif; line-height: 1.2;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 14px; font-weight: 800; letter-spacing: 0.3px;&quot;&gt;TAHAP 3: GSBPM &amp; ROMANTIK&lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10px; opacity: 0.9; font-weight: 500;&quot;&gt;Rabu, 11 Nov 2026 | 09.00-12.00 WIB&lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 11px; font-weight: 700; color: #C7D2FE; margin-top: 2px;&quot;&gt;Rekomendasi BPS &amp; KAK Ber-ARC&lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6366F1;strokeColor=#4F46E5;strokeWidth=1.5;shadow=1;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry as="geometry" x="766" y="98" width="345" height="62" /></mxCell><mxCell id="card_2_1" value="&lt;div style=&quot;font-family: Segoe UI, sans-serif; line-height: 1.35;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 12px; font-weight: 800; color: #4338CA; border-bottom: 1.5px solid #C7D2FE; padding-bottom: 2px; margin-bottom: 5px;&quot;&gt;&#10;        🏛️ 1. PORTAL REKOMENDASI BPS&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #4F46E5; font-weight: 700; margin-bottom: 5px; background: #E0E7FF; padding: 2px 5px; border-radius: 4px; display: inline-block;&quot;&gt;&#10;        🔗 romantik.web.bps.go.id&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #334155;&quot;&gt;&#10;        • &lt;b&gt;Aplikasi ROMANTIK Resmi BPS&lt;/b&gt;&lt;br/&gt;&#10;        • Unduh template: &lt;b&gt;s.id/pss-mempawah-template&lt;/b&gt;&lt;br/&gt;&#10;        • Wajib diajukan &lt;b&gt;SEBELUM&lt;/b&gt; kegiatan jalan!&lt;br/&gt;&#10;        • &lt;i&gt;Pemeriksaan metodologi oleh BPS&lt;/i&gt;&#10;      &lt;/div&gt;&#10;    &lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6366F1;strokeWidth=1.5;shadow=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="776" y="168" width="325" height="150" /></mxCell><mxCell id="card_2_2" value="&lt;div style=&quot;font-family: Segoe UI, sans-serif; line-height: 1.35;&quot;&gt;&#10;      &lt;div style=&quot;font-size: 12px; font-weight: 800; color: #4338CA; border-bottom: 1.5px solid #C7D2FE; padding-bottom: 2px; margin-bottom: 6px;&quot;&gt;&#10;        📝 2. AKSI ENTRI OPERATOR&#10;      &lt;/div&gt;&#10;      &lt;div style=&quot;font-size: 10.5px; color: #1E293B;&quot;&gt;&#10;        • Salin template &lt;b&gt;KAK Model GSBPM&lt;/b&gt;&lt;br/&gt;&#10;        • Cantumkan &lt;b&gt;Advance Release Calendar (ARC)&lt;/b&gt;:&lt;br/&gt;&#10;        &amp;nbsp;&amp;nbsp; - Jadwal pasti rilis publikasi data sektoral&lt;br/&gt;&#10;        • Unggah rancangan kegiatan ke ROMANTIK&lt;br/&gt;&#10;        • Tim BPS telaah rancangan (Bebas Duplikasi)&lt;br/&gt;&#10;        • BPS terbitkan &lt;b&gt;Surat Rekomendasi Resmi&lt;/b&gt;&#10;      &lt;/div&gt;&#10;      &lt;div style=